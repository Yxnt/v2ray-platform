# Copy this file to a private location, fill in real values, then source it
# before running deploy/preflight-cloudrun.sh or deploy/deploy-cloudrun.sh.

export GCP_PROJECT="your-gcp-project-id"
export GCP_REGION="asia-east1"
export CLOUDRUN_SERVICE="v2ray-platform"

export DATABASE_URL="postgres://user:pass@host/dbname?sslmode=require"
export BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
export BOOTSTRAP_ADMIN_PASSWORD="change-me-now"
export CONTROL_PLANE_SESSION_SECRET="replace-with-openssl-rand-hex-32-output"
export CLOUDFRONT_MASTER_KEY="replace-with-openssl-rand-hex-16-output"

# Optional
# export CONTROL_PLANE_ALERT_WEBHOOK_URL="https://your-webhook.example.com/path"
# export IMAGE="asia-east1-docker.pkg.dev/your-gcp-project-id/v2ray-platform/control-plane"
