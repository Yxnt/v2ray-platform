# Copy this file to a private location, fill in real values, then source it
# before running deploy/preflight-server.sh or deploy/deploy-server.sh.

export DEPLOY_HOST="user@example.com"
export DEPLOY_PATH="/opt/v2ray-platform"
export CONTROL_PLANE_PUBLIC_URL="https://control-plane.example.com"
export CONTROL_PLANE_BIND_PORT="127.0.0.1:18080"
export CONTROL_PLANE_IMAGE="ghcr.io/yxnt/v2ray-platform-control-plane:latest"

export BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
export BOOTSTRAP_ADMIN_PASSWORD="change-me-now"
export CONTROL_PLANE_SESSION_SECRET="replace-with-openssl-rand-hex-32-output"
export CONTROL_PLANE_ADMIN_TOKEN="replace-with-random-admin-token"

export POSTGRES_DB="v2ray_platform"
export POSTGRES_USER="v2ray_platform"
export POSTGRES_PASSWORD="replace-with-random-postgres-password"

# Optional local dump path to restore after postgres boots
# export POSTGRES_RESTORE_DUMP="/absolute/path/to/neondb-backup.dump"
# Optional if you prefer an external PostgreSQL instead of the bundled container
# export DATABASE_URL="postgres://user:pass@host/dbname?sslmode=require"

# Optional
# export SSH_OPTS="-o StrictHostKeyChecking=accept-new"
# export CONTROL_PLANE_ALERT_WEBHOOK_URL="https://your-webhook.example.com/path"
